{
  "expo": {
    "name": "Heltog",
    "slug": "atul",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a5555",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.heltog.mobile",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a5555",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Heltog uses the microphone to record voice notes for your WhatsApp chats.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Heltog needs access to your photos so you can send them in chats.",
          "cameraPermission": "Heltog needs the camera so you can take photos to send in chats.",
          "microphonePermission": "Heltog uses the microphone only when you record voice notes."
        }
      ],
      "expo-document-picker",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#0e7c7b",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Heltog reads your contacts only when you choose to import them as WhatsApp contacts."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-web-browser"
    ],
    "scheme": "heltog",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "841a8d92-d48e-4081-8b1d-bbf122792052"
      }
    },
    "owner": "atul9758s-team"
  }
}
