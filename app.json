{
  "expo": {
    "name": "Heltog",
    "slug": "heltog-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a5555",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.heltog.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a5555",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Heltog uses the microphone to record voice notes for your WhatsApp chats.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Heltog needs access to your photos so you can send them in chats.",
          "cameraPermission": "Heltog needs the camera so you can take photos to send in chats.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#0e7c7b",
          "defaultChannel": "messages"
        }
      ]
    ],
    "scheme": "heltog"
  }
}
