+++ b/app/Models/ConversationNote.php
@@ -0,0 +1,28 @@
+<?php
+
+namespace App\Models;
+
+use App\Support\Concerns\HasUuid;
+use App\Support\Scopes\BelongsToTenant;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\SoftDeletes;
+
+/** An internal note on a conversation. Seen by the team only, never sent to the customer. */
+class ConversationNote extends Model
+{
+    use BelongsToTenant, HasFactory, HasUuid, SoftDeletes;
+
+    protected $fillable = ['tenant_id', 'conversation_id', 'user_id', 'body'];
+
+    public function conversation(): BelongsTo
+    {
+        return $this->belongsTo(Conversation::class);
+    }
+
+    public function author(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'user_id');
+    }
+}
