+    public function show(string $conversationUuid): JsonResponse
+    {
+        $this->authorize('conversations.view');
+
+        $conversation = Conversation::where('uuid', $conversationUuid)
+            ->with(['contact', 'phoneNumber', 'assignedAgent'])
+            ->firstOrFail();
+        $this->guardConversationAccess($conversation);
+
+        return $this->ok(['conversation' => new ConversationResource($conversation)]);
+    }
+
+    /** Move a chat between open, pending, resolved and closed. */
+    public function updateStatus(Request $request, string $conversationUuid): JsonResponse
+    {
+        $this->authorize('conversations.status');
+
+        $conversation = Conversation::where('uuid', $conversationUuid)->firstOrFail();
+        $this->guardConversationAccess($conversation);
+
+        $data = $request->validate([
+            'status' => ['required', 'in:open,pending,resolved,closed'],
+        ]);
+
+        $conversation->update(['status' => $data['status']]);
+
+        return $this->ok([
+            'conversation' => new ConversationResource($conversation->load(['contact', 'phoneNumber', 'assignedAgent'])),
+        ]);
+    }
+
+    private function noteToArray(ConversationNote $note): array
+    {
+        return [
+            'id' => $note->uuid,
+            'body' => $note->body,
+            'created_at' => $note->created_at?->toIso8601String(),
+            'author' => $note->author ? ['id' => $note->author->uuid, 'name' => $note->author->name] : null,
+        ];
+    }
+
+    /** Internal notes: visible to the team only, never sent to the customer. */
+    public function notes(string $conversationUuid): JsonResponse
+    {
+        $this->authorize('conversations.view');
+
+        $conversation = Conversation::where('uuid', $conversationUuid)->firstOrFail();
+        $this->guardConversationAccess($conversation);
+
+        $notes = $conversation->notes()->with('author')->orderByDesc('created_at')->limit(200)->get();
+
+        return $this->ok(['notes' => $notes->map(fn (ConversationNote $n) => $this->noteToArray($n))->values()]);
+    }
+
+    public function addNote(Request $request, string $conversationUuid): JsonResponse
+    {
+        $this->authorize('conversations.note');
+
+        $conversation = Conversation::where('uuid', $conversationUuid)->firstOrFail();
+        $this->guardConversationAccess($conversation);
+
+        $data = $request->validate([
+            'body' => ['required', 'string', 'max:2000'],
+        ]);
+
+        $note = ConversationNote::create([
+            'tenant_id' => $conversation->tenant_id,
+            'conversation_id' => $conversation->id,
+            'user_id' => $request->user()->id,
+            'body' => trim($data['body']),
+        ]);
+
+        return $this->ok(['note' => $this->noteToArray($note->load('author'))]);
+    }
+
+    public function deleteNote(string $conversationUuid, string $noteUuid): JsonResponse
+    {
+        $this->authorize('conversations.note');
+
+        $conversation = Conversation::where('uuid', $conversationUuid)->firstOrFail();
+        $this->guardConversationAccess($conversation);
+        $note = $conversation->notes()->where('uuid', $noteUuid)->firstOrFail();
+
+        // Writers can remove their own notes; managers can remove anyone's.
+        if ($note->user_id !== auth()->id() && ! auth()->user()->can('whatsapp.manage')) {
+            abort(403, 'You can only delete your own notes.');
+        }
+
+        $note->delete();
+
+        return $this->ok(['message' => 'Note deleted.']);
+    }
