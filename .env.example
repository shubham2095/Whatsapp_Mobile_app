# Android emulator -> your PC. Real device: use your LAN IP or a tunnel (ngrok).
# Leave unset to use production (https://main.heltog.com/api/v1).
EXPO_PUBLIC_API_URL=https://main.heltog.com/api/v1

# Crash reporting (optional). Leave empty to turn it off. Get the DSN from sentry.io, Project settings, Client keys.
EXPO_PUBLIC_SENTRY_DSN=
